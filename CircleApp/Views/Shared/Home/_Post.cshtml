@using System.Security.Claims;
@using System.Text.RegularExpressions
@using System.Net
@using Microsoft.AspNetCore.Html
@inject CircleApp.Data.Services.IUsersService UserRepository
@model Post

@{
    int loggedInUserId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int result) ? result : 0;

    var loggedInUser = await UserRepository.GetUser(loggedInUserId);
    string currentUserAvatar = loggedInUser?.ProfilePictureUrl;

    TimeSpan timeSpanSincePosted = DateTime.UtcNow.Subtract(Model.DateCreated);

    string displayTime = timeSpanSincePosted switch
    {
        var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d ago",
        var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h ago",
        var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m ago",
        _ => "Just now"
    };

    bool isFavorite = Model.Favorites.Any(f => f.UserId == loggedInUserId);
    bool isLiked = Model.Likes.Any(l => l.UserId == loggedInUserId);
    bool isPrivate = Model.IsPrivate == true && Model.UserId == loggedInUserId;
    bool isReported = Model.Reports.Any(r => r.UserId == loggedInUserId);

    string defaultUserPicture = "~/images/avatar/user.png";

    bool showAllComments = ViewData["ShowAllComments"] as bool? ?? false;
    bool showDetails = ViewData["ShowDetails"] as bool? ?? true;
}

@functions {
    // Tô màu xanh cho phần "@TenTaiKhoan" trong nội dung comment/reply.
    // Tự HtmlEncode nội dung trước để tránh XSS, sau đó mới chèn thẻ <span>.
    private IHtmlContent FormatMentions(string content)
    {
        if (string.IsNullOrEmpty(content)) return HtmlString.Empty;

        string encoded = WebUtility.HtmlEncode(content);

        string formatted = Regex.Replace(
            encoded,
            @"(?<=^|\s)@(\w+)",
            "<span class=\"text-blue-600 font-semibold\">@$1</span>"
        );

        return new HtmlString(formatted);
    }
}

<div id="post-@Model.Id" class="bg-white rounded-xl shadow-sm text-sm font-medium border1">
    @* Post heading *@
    <div class="flex gap-3 sm:p-4 p-2.5 text-sm font-medium ">
        <a asp-controller="Users" asp-action="Details" asp-route-userId="@Model.UserId">
            <img src="@(!string.IsNullOrEmpty(Model.User.ProfilePictureUrl) ? Url.Content("~/" + Model.User.ProfilePictureUrl) : Url.Content(defaultUserPicture))" class="w-9 h-9 rounded-full" />
        </a>
        <div class="flex-1">
            <a asp-controller="Users" asp-action="Details" asp-route-userId="@Model.UserId">
                <h4 class="text-black">@Model.User.FullName</h4>
                <div class="text-xs text-gray-500/80" title="@Model.DateCreated.ToString("dd/MM/yyyy HH:mm")">@displayTime</div>
            </a>
        </div>
        <div class="-mr-1">
            <button type="button" class="button-icon w-8 h-8">
                <ion-icon class="text-xl" name="ellipsis-horizontal"></ion-icon>
            </button>
            <div class="w-[245px] post-options-dropdown" uk-dropdown="pos:bottom-right; animation:uk-animation-scale-up uk-transform-origin-top-right; animate-out:true; mode:click">
                @if (Model.UserId == loggedInUserId)
                {
                    <form asp-controller="Home" asp-action="TogglePostVisibility">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@Model.Id" />
                        <button type="submit" class="hover:!bg-red-50 icon-link">
                            <ion-icon name="@(isPrivate ? "lock-open-outline" : "lock-closed-outline")"></ion-icon> Set as @(isPrivate ? "public" : "private")
                        </button>
                    </form>
                    <hr />
                    <button type="button" onclick="openPostDeleteConfirmation('@Model.Id')" class="text-red-400 hover:!bg-red-50 delete-post-btn">
                        <ion-icon name="trash-bin-outline"></ion-icon> Delete Post
                    </button>
                }
                @if (!isReported)
                {
                    <form asp-controller="Home" asp-action="AddPostReport">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@Model.Id" />
                        <button type="submit" class="hover:!bg-red-50 icon-link">
                            <ion-icon class="text-xl shrink-0" name="flag-outline"></ion-icon> Report
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    @* Post content *@
    <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.Id">
        <div class="sm:px-4 p-2.5 pt-0 w-full">
            <p class="font-normal">@Model.Content</p>
        </div>
    </a>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.Id">
            <div class="relative w-full h-full">
                <img src="@Url.Content("~/" + Model.ImageUrl)" class="sm:rounded-lg w-full h-full object-cover" />
            </div>
        </a>
    }

    @* Icons *@
    <div class="sm:p-4 p-2.5 flex items-center gap-4 text-xs font-semibold">
        <div class="flex items-center gap-2.5">
            <form asp-controller="Home" asp-action="TogglePostLike">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.Id" />
                <button type="submit" class="button-icon like-button @(isLiked ? "text-red-500 bg-red-100" : "")">
                    <ion-icon class="text-lg" name="@(isLiked ? "heart" : "heart-outline")"></ion-icon>
                </button>
            </form>
            <a href="#">@Model.Likes.Count</a>
        </div>

        <div class="flex items-center gap-3">
            <a class="button-icon">
                <ion-icon class="text-lg" name="chatbubble-ellipses-outline"></ion-icon>
            </a>
            <a href="#">@Model.Comments.Count</a>
        </div>

        <div class="ml-auto"></div>

        <div class="flex items-center gap-2.5">
            <form asp-controller="Home" asp-action="TogglePostFavorite">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.Id" />
                <button type="submit" class="button-icon favorite-button ml-auto @(isFavorite ? "text-orange-500 bg-orange-100" : "")">
                    <ion-icon class="text-lg" name="@(isFavorite ? "bookmark" : "bookmark-outline")"></ion-icon>
                </button>
            </form>
            @if (Model.Favorites.Count > 0)
            {
                <a href="#">@Model.Favorites.Count</a>
            }
        </div>
    </div>

    @if (showDetails)
    {
        @* Add comment section *@
        <div>
            <div class="p-2.5 border-t border-gray-100 font-normal space-y-4 relative">

                @* 1. Chỉ lặp các bình luận gốc *@
                @foreach (var comment in showAllComments
                            ? Model.Comments.Where(c => c.ParentCommentId == null).OrderByDescending(p => p.DateCreated)
                            : Model.Comments.Where(c => c.ParentCommentId == null).OrderByDescending(p => p.DateCreated).Take(2))
                {
                    TimeSpan commentTimeSpanSincePosted = DateTime.UtcNow.Subtract(comment.DateCreated);
                    string commentDisplayTime = commentTimeSpanSincePosted switch
                    {
                        var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d",
                        var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h",
                        var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m",
                        _ => "Now"
                    };

                    <div class="flex items-start gap-3 relative">
                        <a asp-controller="Users" asp-action="Details" asp-route-userId="@comment.UserId">
                            <img src="@(!string.IsNullOrEmpty(comment.User.ProfilePictureUrl) ? Url.Content("~/" + comment.User.ProfilePictureUrl) : Url.Content(defaultUserPicture))" class="w-7 h-7 mt-1 rounded-full object-cover" />
                        </a>
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <a asp-controller="Users" asp-action="Details" asp-route-userId="@comment.UserId" class="text-black font-semibold text-sm inline-block">
                                    @comment.User.FullName
                                </a>
                                <small class="text-xs text-gray-400">@commentDisplayTime</small>
                            </div>

                            <p class="mt-0.5 text-sm text-gray-800">
                                @FormatMentions(comment.Content)
                            </p>

                            @* Chuyển nút Reply và Delete xuống nằm ngang hàng dưới nội dung *@
                            <div class="flex items-center gap-3 mt-1.5">
                                <button type="button" onclick="document.getElementById('reply-form-@comment.Id').classList.toggle('hidden')" class="text-xs text-gray-500 hover:text-blue-600 font-medium">Reply</button>

                                @if (comment.UserId == loggedInUserId || Model.UserId == loggedInUserId)
                                {
                                    <form asp-controller="Home" asp-action="RemovePostComment" class="remove-comment-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="commentId" value="@comment.Id" />
                                        <input type="hidden" name="postId" value="@comment.PostId" />
                                        <button type="submit" class="text-xs text-red-400 hover:text-red-600 font-medium" title="Remove post comment">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </div>



                            @* 3. Vòng lặp hiển thị bình luận con *@
                            @if (comment.Replies != null && comment.Replies.Any())
                            {
                                <div class="ml-2 mt-3 pl-3 border-l-2 border-gray-100 space-y-3">
                                    @foreach (var reply in comment.Replies.OrderBy(r => r.DateCreated))
                                    {
                                        TimeSpan replyTimeSpan = DateTime.UtcNow.Subtract(reply.DateCreated);
                                        string replyDisplayTime = replyTimeSpan switch
                                        {
                                            var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d",
                                            var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h",
                                            var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m",
                                            _ => "Now"
                                        };

                                        <div class="flex items-start relative">
                                            @* bỏ gap-2 *@
                                            <a asp-controller="Users" asp-action="Details" asp-route-userId="@reply.UserId" class="shrink-0 mt-1">
                                                <img src="@(!string.IsNullOrEmpty(reply.User.ProfilePictureUrl) ? Url.Content("~/" + reply.User.ProfilePictureUrl) : Url.Content(defaultUserPicture))" class="w-6 h-6 mt-2 shrink-0 rounded-full object-cover" />
                                            </a>
                                            <div class="flex-1">
                                                <div class="bg-gray-50 rounded-2xl px-3 py-2 inline-block min-w-[120px]">
                                                    <div class="flex items-center gap-2">
                                                        <a asp-controller="Users" asp-action="Details" asp-route-userId="@reply.UserId" class="text-black text-xs font-semibold">
                                                            @reply.User.FullName
                                                        </a>
                                                        <small class="text-[10px] text-gray-400">@replyDisplayTime</small>
                                                    </div>
                                                    <p class="text-xs mt-0.5 text-gray-700">@FormatMentions(reply.Content)</p>
                                                </div>

                                                <div class="flex items-center gap-3 mt-1 ml-2">
                                                    <button type="button" onclick="replyToUser('@comment.Id', '@reply.User.FullName')" class="text-[10px] text-gray-500 hover:text-blue-600 font-medium">Reply</button>

                                                    @if (reply.UserId == loggedInUserId || Model.UserId == loggedInUserId)
                                                    {
                                                        <form asp-controller="Home" asp-action="RemovePostComment" class="remove-comment-form">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="commentId" value="@reply.Id" />
                                                            <input type="hidden" name="postId" value="@reply.PostId" />
                                                            <button type="submit" class="text-[10px] text-red-400 hover:text-red-600 font-medium" title="Remove post comment">
                                                                Delete
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @* Form ẩn để Reply *@
                            <form id="reply-form-@comment.Id" asp-controller="Home" asp-action="AddPostComment" class="hidden mt-3 mb-2 flex items-center gap-2 add-comment-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@Model.Id" />
                                <input type="hidden" name="parentCommentId" value="@comment.Id" />

                                <img src="@(!string.IsNullOrEmpty(currentUserAvatar) ? Url.Content("~/" + currentUserAvatar) : Url.Content(defaultUserPicture))" class="w-6 h-6 rounded-full object-cover" />
                                <input type="text" name="content" class="flex-1 text-sm border border-gray-200 rounded-full px-4 py-1.5 bg-gray-50 focus:bg-white focus:outline-none" placeholder="Write a reply..." required />
                                <button type="submit" class="text-xs font-semibold text-blue-600 pr-2">Send</button>
                            </form>
                        </div>
                    </div>
                }

                @if (Model.Comments.Count(c => c.ParentCommentId == null) >= 3 && !showAllComments)
                {
                    <div class="p-1.5 text-sm text-gray-500 hover:text-blue-600">
                        <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.Id">
                            View more comments
                        </a>
                    </div>
                }
            </div>

            @* Form bình luận gốc ở dưới cùng *@
            <form asp-controller="Home" asp-action="AddPostComment" class="add-comment-form">
                @Html.AntiForgeryToken()
                <div class="sm:px-4 sm:py-3 p-2.5 border-t border-gray-100 flex items-center gap-2">
                    <a asp-controller="Users" asp-action="Details" asp-route-userId="@loggedInUserId">
                        <img src="@(!string.IsNullOrEmpty(currentUserAvatar) ? Url.Content("~/" + currentUserAvatar) : Url.Content(defaultUserPicture))" class="w-8 h-8 rounded-full object-cover" />
                    </a>
                    <input type="hidden" name="postId" value="@Model.Id" />
                    <input type="text" name="content" placeholder="Write a comment..."
                           class="flex-1 text-sm border border-gray-100 rounded-full px-4 py-2 bg-gray-50 focus:bg-white focus:outline-none"
                           required />
                    <button type="submit" class="text-sm font-semibold text-blue-600 px-2">Post</button>
                </div>
            </form>
        </div>
    }
</div>

<script>
    function replyToUser(rootCommentId, targetUserName) {
        const form = document.getElementById('reply-form-' + rootCommentId);
        if (form) {
            form.classList.remove('hidden');

            const inputBox = form.querySelector('input[name="content"]');
            if (inputBox) {
                // Dùng @@ để Razor render ra một ký tự tag tên
                inputBox.value = '@@' + targetUserName + ' ';
                inputBox.focus();
            }
        }
    }
</script>
