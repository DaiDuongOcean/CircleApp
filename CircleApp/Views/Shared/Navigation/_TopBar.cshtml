@inject UserManager<User> UserManager
@{
    var loggedInUser = await UserManager.GetUserAsync(User);
    var userName = loggedInUser?.UserName;
    var fullName = loggedInUser?.FullName;
    var profilePictureUrl = loggedInUser?.ProfilePictureUrl;
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<header class="z-[100] h-[--m-top] fixed top-0 left-0 w-full flex items-center bg-white/80 sky-50 backdrop-blur-xl border-b border-slate-200 px-2 sm:px-4">

    <!-- 1. LEFT: Logo & Menu (Không bị co lại) -->
    <div class="flex-shrink-0 flex items-center gap-1 lg:w-[--w-side-sm] 2xl:w-[--w-side]">
        @if (!isAdmin)
        {
            <button uk-toggle="target: #site__sidebar ; cls :!-translate-x-0"
                    class="flex items-center justify-center w-8 h-8 text-xl rounded-full hover:bg-gray-100 xl:hidden group">
                <ion-icon name="menu-outline" class="text-2xl group-aria-expanded:hidden"></ion-icon>
                <ion-icon name="close-outline" class="hidden text-2xl group-aria-expanded:block"></ion-icon>
            </button>
        }

        <div id="logo" class="flex items-center">
            <a asp-controller="Home" asp-action="Index" class="flex items-center">
                <img src="~/images/logo.png" class="w-10 ml-2 md:block hidden" />
                <span class="ml-2 font-semibold">Circle App @(isAdmin ? "- Admin" : "")</span>
            </a>
        </div>
    </div>

    <!-- 2. CENTER: Search Bar -->
    <div class="flex-1 flex justify-center items-center min-w-0 px-2 sm:px-4">
        <form id="search--box" asp-controller="Home" asp-action="Search" method="get"
              class="w-full max-w-2xl xl:max-w-3xl 2xl:max-w-4xl relative rounded-xl overflow-hidden z-20 bg-secondery transition-all max-sm:hidden">
            <ion-icon name="search" class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></ion-icon>
            <input type="text" name="query" placeholder="Search Posts, Friends..."
                   class="w-full !pl-10 !font-normal !bg-transparent h-10 sm:h-12 !text-sm focus:outline-none focus:ring-2 focus:ring-blue-100" />
        </form>
    </div>

    @* Giữ riêng phiên bản mobile *@
    <form asp-controller="Home" asp-action="Search" method="get"
          class="hidden max-sm:block fixed top-2 left-0 w-screen z-20 bg-secondery rounded-xl overflow-hidden">
        <ion-icon name="search" class="absolute left-4 top-1/2 -translate-y-1/2"></ion-icon>
        <input type="text" name="query" placeholder="Search Posts, Friends..." class="w-full !pl-10 !font-normal !bg-transparent h-12 !text-sm" />
    </form>

    <!-- 3. RIGHT: Icons & Profile (Không bị co lại) -->
    <div class="flex-shrink-0 flex items-center gap-2 sm:gap-4 text-black">

        <!-- Messages -->
        <a asp-controller="Chats" asp-action="Index" class="sm:p-2 p-1 rounded-full relative sm:bg-secondery hover:bg-gray-200 transition flex items-center justify-center" title="Tin nhắn">
            <ion-icon name="chatbubble-ellipses-outline" class="text-2xl"></ion-icon>
            <div class="absolute top-0 right-0 -m-1 bg-red-600 text-white text-xs px-1 rounded-full"
                 id="messagesCount" style="display:none;">
                0
            </div>
        </a>

        <!-- Notifications -->
        <div class="relative">
            <button type="button" class="sm:p-2 p-1 rounded-full relative sm:bg-secondery" id="notificationsBtn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 max-sm:hidden">
                    <path d="M5.85 3.5a.75.75 0 00-1.117-1 9.719 9.719 0 00-2.348 4.876.75.75 0 001.479.248A8.219 8.219 0 015.85 3.5zM19.267 2.5a.75.75 0 10-1.118 1 8.22 8.22 0 011.987 4.124.75.75 0 001.48-.248A9.72 9.72 0 0019.266 2.5z" />
                    <path fill-rule="evenodd" d="M12 2.25A6.75 6.75 0 005.25 9v.75a8.217 8.217 0 01-2.119 5.52.75.75 0 00.298 1.206c1.544.57 3.16.99 4.831 1.243a3.75 3.75 0 107.48 0 24.583 24.583 0 004.83-1.244.75.75 0 00.298-1.205 8.217 8.217 0 01-2.118-5.52V9A6.75 6.75 0 0012 2.25zM9.75 18c0-.034 0-.067.002-.1a25.05 25.05 0 004.496 0l.002.1a2.25 2.25 0 11-4.5 0z" clip-rule="evenodd" />
                </svg>
                <div class="absolute top-0 right-0 -m-1 bg-red-600 text-white text-xs px-1 rounded-full" id="notificationsCount" style="display:none;">0</div>
            </button>

            <div class="hidden bg-white pr-1.5 rounded-lg drop-shadow-xl md:w-[365px] w-screen border2" uk-drop="offset:6;pos: bottom-right; mode: click; animate-out: true;">
                <div class="flex items-center justify-between gap-2 p-4 pb-2">
                    <h3 class="font-bold text-xl">Notifications</h3>
                </div>
                <div class="text-sm h-[400px] w-full overflow-y-auto pr-5">
                    <div class="pl-2 p-1 text-sm font-normal" id="notification-dropdown">
                        No notifications...
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile -->
        <div class="relative">
            <div class="rounded-full relative bg-secondery cursor-pointer shrink-0">
                <img src="@(string.IsNullOrEmpty(profilePictureUrl) ? Url.Content("~/images/avatar/user.png") : Url.Content("~/" + profilePictureUrl))" class="sm:w-9 sm:h-9 w-7 h-7 rounded-full shadow shrink-0" />
            </div>
            <div class="hidden bg-white rounded-lg drop-shadow-xl w-64 border2" uk-drop="offset:6;pos: bottom-right;animate-out: true;">
                <a asp-controller="Users" asp-action="Details" asp-route-userId="@loggedInUser.Id" style="display: block; width: 100%;">
                    <div class="p-4 py-5" style="display: flex; align-items: center; gap: 1rem; width: 100%;">
                        <img src="@(string.IsNullOrEmpty(profilePictureUrl) ? Url.Content("~/images/avatar/user.png") : Url.Content("~/" + profilePictureUrl))" class="w-10 h-10 rounded-full shadow" style="flex-shrink: 0;" />
                        <div style="width: 140px; overflow: hidden;">
                            <h4 class="text-sm font-medium text-black" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@fullName</h4>
                            <div class="text-sm mt-1 text-blue-600 font-light/70" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@userName">@userName</div>
                        </div>
                    </div>
                </a>
                <hr />
                <nav>
                    <a asp-controller="Settings" asp-action="Index">
                        <div class="flex items-center gap-2.5 hover:bg-secondery p-2 px-2.5 rounded-md">
                            <ion-icon name="settings-outline" class="text-lg"></ion-icon> My Account
                        </div>
                    </a>
                    <hr />
                    <a asp-controller="Authentication" asp-action="Logout">
                        <div class="flex items-center gap-2.5 hover:bg-secondery p-2 px-2.5 rounded-md">
                            <ion-icon name="exit-outline" class="text-lg"></ion-icon> Log Out
                        </div>
                    </a>
                </nav>
            </div>
        </div>
    </div>
</header>

<script src="https://cdnjs.cloudflare.com/ajax/libs/aspnet-signalr/1.0.27/signalr.min.js"
        integrity="sha512-a+73ErrZPjhqOu0qbW1QLsenEF4pvDjmnd+Ws6hkDyJlrwAigOQAxQhIT+fPNFWScUvtJQvn+G535TT2C6/G4g=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {

        fetch("/Notifications/GetCount", {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        }).then(response => response.json()).then(data => {
            updateNotificationBadge(data);
        }).catch(error => console.error("Error fetching notification count: ", error));

        document.getElementById('notificationsBtn').addEventListener('click', () => {
            fetch('/Notifications/GetNotifications')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('notification-dropdown').innerHTML = html;
                });
        });

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", (message) => {
            updateNotificationBadge(message);
        });

        connection.start()
            .then(() => console.log("SignalR connected"))
            .catch((err) => console.log("SignalR connection error: ", err));


        fetch("/Chats/GetUnreadCount")
            .then(r => r.json())
            .then(count => updateMessageBadge(count))
            .catch(err => console.error(err));

        function updateMessageBadge(count) {
            const badge = document.getElementById("messagesCount");
            if (count > 0) {
                badge.style.display = "inline-block";
                badge.innerHTML = count;
            } else {
                badge.style.display = "none";
            }
        }

        const chatConnection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
        chatConnection.on("UpdateUnreadCount", (count) => updateMessageBadge(count));
        chatConnection.start().catch(err => console.error(err.toString()));
    });

    // Cập nhật badge với giá trị tuyệt đối lấy từ server.
    // Ẩn hẳn badge khi count = 0 thay vì hiển thị số "0" -> tránh giật khi chuyển trang.
    function updateNotificationBadge(count) {
        const badge = document.getElementById("notificationsCount");
        if (!badge) return;
        if (count > 0) {
            badge.style.display = "inline-block";
            badge.innerHTML = count;
        } else {
            badge.style.display = "none";
            badge.innerHTML = 0;
        }
    }

    // Giảm badge đi 1 ngay lập tức (optimistic update), không cần chờ server phản hồi
    function decrementNotificationBadge() {
        const badge = document.getElementById("notificationsCount");
        if (!badge) return;
        const current = parseInt(badge.innerHTML, 10) || 0;
        updateNotificationBadge(Math.max(current - 1, 0));
    }

    // Được gọi khi người dùng click vào 1 thông báo trong dropdown (xem _Notifications.cshtml)
    function handleNotificationClick(event, notificationId, isRead) {
        if (isRead) return;

        decrementNotificationBadge();

        const url = `/Notifications/MarkAsRead?notificationId=${notificationId}`;
        if (navigator.sendBeacon) {
            navigator.sendBeacon(url);
        } else {
            fetch(url, { method: 'POST', keepalive: true }).catch(err => console.error(err));
        }
    }
</script>
