@using CircleApp.Controllers
@using CircleApp.Data.Models
@model List<Message>

@{
    ViewData["Title"] = "Tin nhắn";
    ViewData["HideSidebar"] = true;
    var defaultUserPicture = "~/images/avatar/user.png";
    var onlineUserIds = ViewBag.OnlineUserIds as List<int> ?? new List<int>();
}

<style>
    :root {
        --topbar-height: 80px;
    }

    .messages-page-wrapper {
        padding-top: var(--topbar-height);
        box-sizing: border-box;
    }

    /* Bảng chọn emoji */
    #emojiPicker {
        position: absolute;
        bottom: 60px;
        left: 0;
        width: 280px;
        max-height: 220px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        padding: 10px;
        display: none;
        flex-wrap: wrap;
        gap: 4px;
        z-index: 50;
    }

        #emojiPicker.open {
            display: flex;
        }

        #emojiPicker span {
            font-size: 20px;
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
            line-height: 1;
        }

            #emojiPicker span:hover {
                background: #f3f4f6;
            }
</style>

<div class="messages-page-wrapper w-full max-w-7xl mx-auto px-4 pb-4">
    <div class="flex w-full border border-gray-200 rounded-2xl overflow-hidden bg-white shadow-md relative z-10"
         style="height: calc(100vh - var(--topbar-height) - 24px); min-height: 550px;">

        <!-- CỘT TRÁI -->
        <div class="w-1/3 md:w-1/4 lg:w-[320px] border-r border-gray-200 bg-white flex flex-col shrink-0">
            <div class="p-4 border-b border-gray-200 bg-white flex items-center justify-between shrink-0">
                <h2 class="text-xl font-extrabold text-gray-900">Tin nhắn</h2>
                <ion-icon name="create-outline" class="text-2xl text-gray-500 cursor-pointer hover:text-blue-600 transition-colors"></ion-icon>
            </div>

            <div class="overflow-y-auto flex-1 p-2 space-y-1">
                @if (ViewBag.ChatUsers != null)
                {
                    foreach (var user in ViewBag.ChatUsers)
                    {
                        bool isSelected = ViewBag.Receiver != null && ViewBag.Receiver.Id == user.Id;
                        bool isOnline = onlineUserIds.Contains((int)user.Id);

                        <a asp-controller="Chats" asp-action="Index" asp-route-receiverId="@user.Id"
                           class="flex items-center gap-3 p-2.5 rounded-xl transition-all duration-200 @(isSelected ? "bg-blue-50 ring-1 ring-blue-200" : "hover:bg-gray-50") block w-full">
                            <div class="relative shrink-0">
                                <img src="@(!string.IsNullOrEmpty(user.ProfilePictureUrl) ? Url.Content("~/" + user.ProfilePictureUrl) : Url.Content(defaultUserPicture))"
                                     style="width:48px;height:48px;border-radius:9999px;object-fit:cover;"
                                     class="shadow-sm border border-gray-100" />
                                <div class="user-status-dot absolute bottom-0 right-0 w-3.5 h-3.5 border-2 border-white rounded-full"
                                     data-user-id="@user.Id"
                                     style="background-color:@(isOnline ? "#22c55e" : "#9ca3af");"></div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="font-semibold text-[15px] text-gray-900 truncate">@user.FullName</div>
                                <div class="text-xs text-gray-500 truncate mt-0.5">
                                    @(isSelected ? "Đang mở trò chuyện..." : "Nhấn để xem tin nhắn")
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- CỘT PHẢI -->
        <div class="flex-1 flex flex-col relative bg-gray-50 min-w-0">
            @if (ViewBag.Receiver != null)
            {
                var receiver = ViewBag.Receiver as User;
                int currentUserId = ViewBag.CurrentUserId;
                bool receiverIsOnline = ViewBag.ReceiverIsOnline ?? false;

                <div class="px-5 py-3 border-b border-gray-200 flex items-center gap-3 bg-white z-10 shadow-sm shrink-0">
                    <img src="@(!string.IsNullOrEmpty(receiver.ProfilePictureUrl) ? Url.Content("~/" + receiver.ProfilePictureUrl) : Url.Content(defaultUserPicture))"
                         style="width:40px;height:40px;border-radius:9999px;object-fit:cover;" class="shadow-sm" />
                    <div class="min-w-0">
                        <h3 class="font-bold text-gray-900 leading-tight truncate">@receiver.FullName</h3>
                        <span id="receiverStatusText" class="text-xs font-medium" data-user-id="@receiver.Id"
                              style="color:@(receiverIsOnline ? "#16a34a" : "#9ca3af");">
                            @(receiverIsOnline ? "Đang hoạt động" : "Không hoạt động")
                        </span>
                    </div>
                </div>

                <div id="chat-messages" class="flex-1 overflow-y-auto p-5 space-y-4">
                    @foreach (var msg in Model)
                    {
                        bool isMine = msg.SenderId == currentUserId;
                        <div class="flex @(isMine ? "justify-end" : "justify-start")">
                            <div class="flex flex-col @(isMine ? "items-end" : "items-start")" style="max-width:70%;">
                                <div class="px-4 py-2.5 text-[15px] shadow-sm rounded-2xl @(isMine ? "rounded-br-sm" : "rounded-bl-sm border border-gray-200")"
                                     style="@(isMine ? "background-color:#2563eb;color:#ffffff;" : "background-color:#ffffff;color:#111827;")">
                                    @if (!string.IsNullOrEmpty(msg.AttachmentUrl))
                                    {
                                        if (msg.AttachmentType == "image")
                                        {
                                            <a href="@Url.Content("~" + msg.AttachmentUrl)" target="_blank">
                                                <img src="@Url.Content("~" + msg.AttachmentUrl)"
                                                     style="max-width:220px;border-radius:12px;display:block;margin-bottom:@(string.IsNullOrEmpty(msg.Content) ? "0" : "6px");" />
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Content("~" + msg.AttachmentUrl)" target="_blank" download
                                               style="display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit;margin-bottom:@(string.IsNullOrEmpty(msg.Content) ? "0" : "6px");">
                                                <ion-icon name="document-outline" style="font-size:22px;"></ion-icon>
                                                <span style="text-decoration:underline;">Tệp đính kèm</span>
                                            </a>
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(msg.Content))
                                    {
                                        @msg.Content
                                    }
                                </div>
                                <span style="font-size:11px;color:#9ca3af;margin-top:2px;padding:0 4px;">@ChatsController.ToVietnamTime(msg.DateSent).ToString("hh:mm tt")</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="p-4 bg-white flex gap-3 items-center border-t border-gray-200 shrink-0" style="position:relative;">
                    <input type="hidden" id="receiverId" value="@receiver.Id" />
                    <input type="file" id="attachmentInput" style="display:none;"
                           accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar,.txt" />

                    <button onclick="document.getElementById('attachmentInput').click()" type="button"
                            style="background:transparent;border:none;flex-shrink:0;cursor:pointer;">
                        <ion-icon name="attach-outline" style="font-size:26px;color:#6b7280;"></ion-icon>
                    </button>

                    <div id="attachmentPreview" style="display:none;align-items:center;gap:8px;background:#eef2ff;padding:4px 10px;border-radius:14px;font-size:13px;color:#374151;white-space:nowrap;">
                        <span id="attachmentName"></span>
                        <span onclick="clearAttachment()" style="cursor:pointer;color:#ef4444;font-weight:bold;">×</span>
                    </div>

                    <div class="flex-1 bg-gray-100 rounded-3xl px-4 py-2.5 flex items-center gap-2 border border-transparent min-w-0" style="position:relative;">
                        <ion-icon name="happy-outline" id="emojiToggleBtn" class="text-2xl text-gray-400 cursor-pointer shrink-0"></ion-icon>
                        <div id="emojiPicker"></div>
                        <input type="text" id="messageInput" class="w-full bg-transparent focus:outline-none text-[15px] text-gray-800"
                               placeholder="Nhập tin nhắn..." onkeypress="handleEnter(event)" autocomplete="off" />
                    </div>

                    <button onclick="sendMsg()"
                            class="rounded-full flex items-center justify-center hover:opacity-90 transition-colors shadow-sm shrink-0"
                            style="width:44px;height:44px;background-color:#2563eb;color:#ffffff;">
                        <ion-icon name="send" class="text-xl ml-1"></ion-icon>
                    </button>
                </div>
            }
            else
            {
                <div class="flex-1 flex flex-col items-center justify-center text-gray-400 gap-4 bg-white">
                    <div class="w-24 h-24 bg-gray-50 rounded-full flex items-center justify-center border-4 border-gray-100">
                        <ion-icon name="paper-plane-outline" class="text-5xl text-gray-300 ml-2"></ion-icon>
                    </div>
                    <p class="text-[17px] font-medium text-gray-500">Bắt đầu cuộc trò chuyện mới</p>
                </div>
            }
        </div>
    </div>
</div>

<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const chatBox = document.getElementById("chat-messages");
    if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

    // ===== EMOJI PICKER =====
    const EMOJI_LIST = ["😀","😁","😂","🤣","😊","😍","😘","😜","🤔","😎",
                         "😢","😭","😡","👍","👎","👏","🙏","🔥","🎉","❤️",
                         "💔","😴","🥳","😱","🤗","🙌","💯","✨","🤝","👀"];

    const emojiPicker = document.getElementById("emojiPicker");
    const emojiToggleBtn = document.getElementById("emojiToggleBtn");
    const messageInput = document.getElementById("messageInput");

    if (emojiPicker) {
        EMOJI_LIST.forEach(emoji => {
            const span = document.createElement("span");
            span.textContent = emoji;
            span.onclick = () => {
                messageInput.value += emoji;
                messageInput.focus();
            };
            emojiPicker.appendChild(span);
        });
    }

    if (emojiToggleBtn) {
        emojiToggleBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            emojiPicker.classList.toggle("open");
        });
        document.addEventListener("click", (e) => {
            if (!emojiPicker.contains(e.target) && e.target !== emojiToggleBtn) {
                emojiPicker.classList.remove("open");
            }
        });
    }

    // ===== ĐÍNH KÈM FILE =====
    let pendingAttachment = null;

    const attachmentInputEl = document.getElementById("attachmentInput");
    if (attachmentInputEl) {
        attachmentInputEl.addEventListener("change", async function (e) {
            const file = e.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append("file", file);

            try {
                const res = await fetch("/Chats/UploadAttachment", { method: "POST", body: formData });
                if (!res.ok) {
                    alert("Không thể tải file lên. Vui lòng thử lại.");
                    return;
                }
                const data = await res.json();
                pendingAttachment = data;
                document.getElementById("attachmentName").textContent = data.fileName;
                document.getElementById("attachmentPreview").style.display = "flex";
            } catch (err) {
                console.error(err);
                alert("Lỗi khi tải file lên.");
            }
            e.target.value = "";
        });
    }

    function clearAttachment() {
        pendingAttachment = null;
        const preview = document.getElementById("attachmentPreview");
        if (preview) preview.style.display = "none";
    }

    function renderMessageBubble(isMine, content, attachmentUrl, attachmentType, time) {
        let inner = "";
        if (attachmentUrl) {
            if (attachmentType === "image") {
                inner += `<a href="${attachmentUrl}" target="_blank"><img src="${attachmentUrl}" style="max-width:220px;border-radius:12px;display:block;margin-bottom:${content ? '6px' : '0'};" /></a>`;
            } else {
                inner += `<a href="${attachmentUrl}" target="_blank" download style="display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit;margin-bottom:${content ? '6px' : '0'};">
                            <ion-icon name="document-outline" style="font-size:22px;"></ion-icon>
                            <span style="text-decoration:underline;">Tệp đính kèm</span>
                           </a>`;
            }
        }
        if (content) inner += content;

        const bubbleStyle = isMine
            ? "background-color:#2563eb;color:#ffffff;"
            : "background-color:#ffffff;color:#111827;border:1px solid #e5e7eb;";

        const wrapDiv = document.createElement("div");
        wrapDiv.className = `flex ${isMine ? "justify-end" : "justify-start"}`;
        wrapDiv.innerHTML = `
            <div class="flex flex-col ${isMine ? "items-end" : "items-start"}" style="max-width:70%;">
                <div class="px-4 py-2.5 text-[15px] shadow-sm rounded-2xl ${isMine ? "rounded-br-sm" : "rounded-bl-sm"}" style="${bubbleStyle}">
                    ${inner}
                </div>
                <span style="font-size:11px;color:#9ca3af;margin-top:2px;padding:0 4px;">${time}</span>
            </div>`;
        return wrapDiv;
    }

    const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

    connection.on("ReceiveMessage", function (senderId, message, attachmentUrl, attachmentType, sentAtUtc) {
        const receiverInput = document.getElementById("receiverId");
        if (receiverInput && senderId == receiverInput.value) {
            const time = sentAtUtc
                ? new Date(sentAtUtc).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true })
                : "";
            const bubble = renderMessageBubble(false, message, attachmentUrl, attachmentType, time);
            chatBox.appendChild(bubble);
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    });

    // ===== TRẠNG THÁI ONLINE/OFFLINE REALTIME =====
    connection.on("UserStatusChanged", function (userId, isOnline) {
        // Cập nhật chấm tròn trong sidebar
        document.querySelectorAll(`.user-status-dot[data-user-id="${userId}"]`).forEach(dot => {
            dot.style.backgroundColor = isOnline ? "#22c55e" : "#9ca3af";
        });

        // Cập nhật chữ "Đang hoạt động" trên header nếu đang xem đúng người này
        const statusText = document.getElementById("receiverStatusText");
        if (statusText && statusText.dataset.userId == userId) {
            statusText.textContent = isOnline ? "Đang hoạt động" : "Không hoạt động";
            statusText.style.color = isOnline ? "#16a34a" : "#9ca3af";
        }
    });

    connection.start().catch(err => console.error(err.toString()));

    function sendMsg() {
        const receiverId = document.getElementById("receiverId").value;
        const input = document.getElementById("messageInput");
        const message = input.value.trim();

        if (message === "" && !pendingAttachment) return;

        const attachmentUrl = pendingAttachment ? pendingAttachment.url : null;
        const attachmentType = pendingAttachment ? pendingAttachment.type : null;

        connection.invoke("SendMessage", receiverId, message, attachmentUrl, attachmentType)
            .catch(err => console.error(err.toString()));

        const now = new Date();
        const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
        const bubble = renderMessageBubble(true, message, attachmentUrl, attachmentType, time);
        chatBox.appendChild(bubble);
        chatBox.scrollTop = chatBox.scrollHeight;

        input.value = "";
        clearAttachment();
        input.focus();
    }

    function handleEnter(e) { if (e.key === 'Enter') { e.preventDefault(); sendMsg(); } }
</script>