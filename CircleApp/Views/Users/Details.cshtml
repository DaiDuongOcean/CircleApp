@using CircleApp.Data.Helpers.Constants
@model GetUserProfileVM

<main id="site__main" class="2xl:ml-[--w-side]  xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">

    <div class="max-w-[1065px] mx-auto max-lg:-m-2.5">
        <div class="bg-white shadow lg:rounded-b-xl lg:-mt-10">
            <div class="relative overflow-hidden w-full lg:h-8 h-8"></div>
            <div class="p-4 flex flex-row items-center">
                <div class="flex-shrink-0" style="margin-right: 10px;">
                    <div class="relative lg:h-28 lg:w-28 w-28 h-28">
                        <div class="relative overflow-hidden rounded-full md:border-[6px] border-gray-100 shrink-0 w-full h-full">
                            <img class="w-full h-full object-cover"
                                src="@(string.IsNullOrEmpty(Model.User.ProfilePictureUrl) ?
                                Url.Content("~/images/avatar/user.png") :
                                Url.Content("~/" + Model.User.ProfilePictureUrl))" />
                        </div>
                    </div>
                </div>
                <div>
                    <h3 class="md:text-3xl text-base font-bold text-black">@Model.User.FullName</h3>
                    <p class="mt-2 text-gray-500">@Model.User.UserName</p>

                    @* MỚI: nút kết bạn + nhắn tin *@
                    @if (Model.RelationshipStatus != "Self")
                    {
                        var currentPath = Context.Request.Path + Context.Request.QueryString;

                        <div class="flex items-center gap-2 mt-3">

                            @if (Model.RelationshipStatus == "Friends")
                            {
                                <form asp-controller="Friends" asp-action="RemoveFriend" method="post">
                                    <input type="hidden" name="friendshipId" value="@Model.FriendshipId" />
                                    <input type="hidden" name="returnUrl" value="@currentPath" />
                                    <button type="submit" class="button bg-gray-100 text-black gap-1">
                                        <ion-icon name="people-outline" class="text-lg -ml-1"></ion-icon> Bạn bè
                                    </button>
                                </form>
                            }
                            else if (Model.RelationshipStatus == "PendingSent")
                            {
                                <form asp-controller="Friends" asp-action="UpdateFriendRequest" method="post">
                                    <input type="hidden" name="requestId" value="@Model.FriendRequestId" />
                                    <input type="hidden" name="status" value="@FriendshipStatus.Canceled" />
                                    <input type="hidden" name="returnUrl" value="@currentPath" />
                                    <button type="submit" class="button bg-gray-100 text-black gap-1">
                                        <ion-icon name="time-outline" class="text-lg -ml-1"></ion-icon> Đã gửi lời mời
                                    </button>
                                </form>
                            }
                            else if (Model.RelationshipStatus == "PendingReceived")
                            {
                                <form asp-controller="Friends" asp-action="UpdateFriendRequest" method="post">
                                    <input type="hidden" name="requestId" value="@Model.FriendRequestId" />
                                    <input type="hidden" name="status" value="@FriendshipStatus.Accepted" />
                                    <input type="hidden" name="returnUrl" value="@currentPath" />
                                    <button type="submit" class="button bg-primary-soft text-primary gap-1">
                                        <ion-icon name="checkmark-circle-outline" class="text-lg -ml-1"></ion-icon> Chấp nhận lời mời
                                    </button>
                                </form>

                                <form asp-controller="Friends" asp-action="UpdateFriendRequest" method="post">
                                    <input type="hidden" name="requestId" value="@Model.FriendRequestId" />
                                    <input type="hidden" name="status" value="@FriendshipStatus.Rejected" />
                                    <input type="hidden" name="returnUrl" value="@currentPath" />
                                    <button type="submit" class="button bg-gray-100 text-black gap-1">
                                        Từ chối
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Friends" asp-action="SendFriendRequest" method="post">
                                    <input type="hidden" name="receiverId" value="@Model.User.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentPath" />
                                    <button type="submit" class="button bg-primary-soft text-primary gap-1">
                                        <ion-icon name="person-add-outline" class="text-lg -ml-1"></ion-icon> Thêm bạn bè
                                    </button>
                                </form>
                            }

                            <a asp-controller="Chats" asp-action="Index" asp-route-receiverId="@Model.User.Id"
                               class="button bg-gray-100 text-black gap-1">
                                <ion-icon name="chatbubble-ellipses-outline" class="text-lg -ml-1"></ion-icon> Nhắn tin
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="flex 2xl:gap-12 gap-10 mt-8 max-lg:flex-col" id="js-oversized">
            <div class="flex-1 xl:space-y-6 space-y-3">
                @foreach (var post in Model.Posts)
                {
                    <partial name="Home/_Post" model="post"
                            view-data='new ViewDataDictionary(ViewData)
                            {
                                { "ShowAllComment", false },
                                {"ShowDetails", false }
                            }' />
                }
            </div>
            <div class="lg:w-[400px]">
                <div class="lg:space-y-4 lg:pb-8 max-lg:grid sm:grid-cols-2 max-lg:gap-6"
                     uk-sticky="media: 1024; end: #js-oversized; offset: 80">


                    <div class="box p-5 px-6">
                        <div class="flex items-ce justify-between text-black">

                            <h3 class="font-bold text-lg">
                                Bạn bè
                                <span class="block text-sm text-gray-500 mt-0. font-normal">@Model.FriendsCount bạn bè</span>
                            </h3>

                        </div>

                        @if (Model.FriendsList != null && Model.FriendsList.Any())
                        {
                            <div class="grid grid-cols-3 gap-2 gap-y-5 text-center text-sm mt-4 mb-2">
                                @foreach (var friend in Model.FriendsList)
                                {
                                    <a asp-controller="Users" asp-action="Details" asp-route-userId="@friend.Id">
                                        <div class="relative w-full aspect-square rounded-lg overflow-hidden border border-gray-200 bg-gray-50">
                                            <img src="@(string.IsNullOrEmpty(friend.ProfilePictureUrl) ? Url.Content("~/images/avatar/user.png") : Url.Content("~/" + friend.ProfilePictureUrl))"
                                                 class="object-cover w-full h-full inset-0" />
                                        </div>
                                        <div class="mt-2 line-clamp-1 text-black">@friend.FullName</div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-gray-500 mt-4">Chưa có bạn bè nào.</p>
                        }
                    </div>


                </div>
            </div>
        </div>
    </div>

</main>

<partial name="Home/_PostDeleteConfirmation"></partial>

<script>
    function openPostDeleteConfirmation(postId){
        document.querySelectorAll('.post-options-dropdown').forEach(function(dropdownEl){
            var dropdown = UIkit.dropdown(dropdownEl);
            if (dropdown) dropdown.hide(false);
        });

        document.getElementById('deleteConfirmationPostId').value = postId;
        document.getElementById('deleteConfirmationReturnUrl').value = window.location.pathname + window.location.search;
        UIkit.modal('#postDeleteDialog').show();
    }
</script>