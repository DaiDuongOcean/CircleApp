@model CircleApp.ViewModels.Home.SearchResultVM
<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="max-w-[680px] mx-auto mt-4">
        <div class="bg-white rounded-xl shadow-sm md:p-4 p-3 mb-6 border1">
            <h3 class="font-bold text-lg">Kết quả tìm kiếm cho: <span class="text-blue-600">"@Model.Query"</span></h3>
        </div>

        @* Khu vực Friends *@
        <div class="bg-white rounded-xl shadow-sm md:p-4 p-3 mb-6 border1">
            <h4 class="font-semibold text-base mb-3">Người dùng</h4>
            @if (Model.Friends == null || !Model.Friends.Any())
            {
                <p class="text-gray-500 text-sm">Không tìm thấy người dùng nào.</p>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var item in Model.Friends)
                    {
                        <a asp-controller="Friends" asp-action="Profile" asp-route-id="@item.User.Id"
                           class="flex items-center gap-3 p-2 rounded-lg hover:bg-secondery">
                            <img src="@(string.IsNullOrEmpty(item.User.ProfilePictureUrl) ? Url.Content("~/images/avatar/user.png") : Url.Content("~/" + item.User.ProfilePictureUrl))"
                                 class="w-10 h-10 rounded-full object-cover shrink-0" />
                            <div>
                                <div class="font-medium">@item.User.FullName</div>
                                <div class="text-xs text-gray-500">@item.FriendsCount bạn bè</div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        @* Khu vực Posts *@
        <div id="posts-container" class="space-y-4">
            <h4 class="font-semibold text-base mb-3">Bài viết</h4>
            @if (Model.Posts == null || !Model.Posts.Any())
            {
                <div class="bg-white rounded-xl p-8 text-center text-gray-500 shadow-sm border1">
                    <ion-icon name="search-outline" class="text-4xl mb-2 text-gray-300"></ion-icon>
                    <p>Không tìm thấy bài viết nào chứa từ khóa này.</p>
                </div>
            }
            else
            {
                @foreach (var post in Model.Posts)
                {
                    <partial name="Home/_Post" model="post" view-data='new ViewDataDictionary(ViewData) { { "ShowAllComments", false } }' />
                }
            }
        </div>
    </div>
</main>